# Copy to .env and fill in. .env is gitignored.
# OPENAI_API_KEY: optional here; the repo-root .env OPENAI_KEY is used when this is empty.
OPENAI_API_KEY=
# Hard cap on estimated OpenAI spend per dev-server session (USD). Calls are refused past this.
OPENAI_SESSION_BUDGET_USD=5
# Model for product imports (vision + strict JSON). gpt-4o-mini ≈ $0.001/import; gpt-4.1-mini follows layout rules better (~$0.004).
OPENAI_MODEL=gpt-4o-mini
# Model for the ★ shopping agent and search fallback (needs the web_search tool: gpt-4.1-mini / gpt-4.1 / gpt-5-mini).
OPENAI_SEARCH_MODEL=gpt-4.1-mini
# Where the FastAPI service (services/api) runs; the dev server proxies /api/v1 there (default http://127.0.0.1:8000).
DREAMGRID_API_URL=
# Optional: make the browser call the API directly instead of through the proxy (needs CORS on the API).
VITE_API_BASE_URL=
