# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=
# Hard cap on estimated OpenAI spend per dev-server session (USD). Calls are refused past this.
OPENAI_SESSION_BUDGET_USD=5
# Legacy spec-import endpoint only. + Add furniture uses services/api/.env (Sol).
OPENAI_MODEL=gpt-4o-mini
# Model for the ★ shopping agent and search fallback (needs the web_search tool: gpt-4.1-mini / gpt-4.1 / gpt-5-mini).
OPENAI_SEARCH_MODEL=gpt-4.1-mini
# Server-side proxy to the Blender backend. Browser uses same-origin /api/v1.
DREAMGRID_API_TARGET=http://127.0.0.1:8000
