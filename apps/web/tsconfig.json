{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": { "@contracts": ["../../packages/contracts/index.ts"], "@dreamgrid/contracts": ["../../packages/contracts/src/index.ts"] }
  },
  "include": ["src", "../../packages/contracts/index.ts"]
}
