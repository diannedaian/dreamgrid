{
  "name": "@dreamgrid/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical shared data contracts for DreamGrid",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas/*": "./schemas/*.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
