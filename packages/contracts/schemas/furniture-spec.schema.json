{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamgrid.dev/schemas/furniture-spec.schema.json",
  "title": "FurnitureSpec",
  "description": "A bounded declarative instruction set for the trusted Blender interpreter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "category", "dimensionsM", "materials", "parts"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "category": { "enum": ["bed", "desk", "chair", "shelf", "lamp", "decor"] },
    "dimensionsM": { "$ref": "#/$defs/dimensionsM" },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/material" }
    },
    "lights": {
      "type": "array", "maxItems": 4,
      "items": { "$ref": "#/$defs/emitter" }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/part" }
    }
  },
  "$defs": {
    "emitter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "position", "direction", "kind", "glowMaterials"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 48 },
        "position": { "$ref": "#/$defs/positionM" },
        "direction": { "$ref": "#/$defs/positionM" },
        "kind": { "enum": ["point", "spot"] },
        "glowMaterials": { "type": "array", "maxItems": 4, "items": { "type": "string" } }
      }
    },
    "dimensionsM": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "positionM": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -20, "maximum": 20 },
        { "type": "number", "minimum": -20, "maximum": 20 },
        { "type": "number", "minimum": -20, "maximum": 20 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "rotationDeg": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -360, "maximum": 360 },
        { "type": "number", "minimum": -360, "maximum": 360 },
        { "type": "number", "minimum": -360, "maximum": 360 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "baseColorHex", "roughness", "metallic"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "baseColorHex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metallic": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "offsetM"],
      "properties": {
        "count": { "type": "integer", "minimum": 2, "maximum": 16 },
        "offsetM": { "$ref": "#/$defs/positionM" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "primitive",
        "role",
        "dimensionsM",
        "positionM",
        "rotationDeg",
        "materialId"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "primitive": { "enum": ["box", "rounded-box", "cylinder", "shade", "sphere", "lathe", "tube"] },
        "role": { "enum": ["body", "top", "leg", "shelf", "support", "accent"] },
        "dimensionsM": { "$ref": "#/$defs/dimensionsM" },
        "positionM": { "$ref": "#/$defs/positionM" },
        "rotationDeg": { "$ref": "#/$defs/rotationDeg" },
        "materialId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "cornerRadiusM": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "repeat": { "$ref": "#/$defs/repeat" },
        "tubeRadiusM": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.2 },
        "pathM": {
          "type": "array", "minItems": 2, "maxItems": 16,
          "items": { "$ref": "#/$defs/positionM" }
        },
        "profile": {
          "type": "array", "minItems": 3, "maxItems": 24,
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 10 },
              { "type": "number", "minimum": -10, "maximum": 10 }
            ]
          }
        }
      }
    }
  }
}
