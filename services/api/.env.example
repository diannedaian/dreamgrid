# Copy this file to .env for local development. Never commit .env.
DREAMGRID_ENVIRONMENT=development
DREAMGRID_LOG_LEVEL=INFO
DREAMGRID_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Linda: product sourcing. "auto" (default) is live when an OpenAI key is present and
# fixture otherwise; "fixture" forces the no-key demo path; "live" requires a key.
# The key is read as DREAMGRID_OPENAI_API_KEY, OPENAI_API_KEY, or OPENAI_KEY from the
# environment, services/api/.env, or the repository-root .env. Never commit a key.
DREAMGRID_PRODUCT_SOURCING=auto
DREAMGRID_OPENAI_API_KEY=
DREAMGRID_OPENAI_MODEL=gpt-4.1-mini
DREAMGRID_OPENAI_WEB_SEARCH_TOOL=web_search
# Product search backend: auto (SerpAPI if keyed, else OpenAI web search, else fixture).
# SerpAPI key is read as DREAMGRID_SERPAPI_API_KEY, SERPAPI_API_KEY, or SERPAPI_KEY.
DREAMGRID_PRODUCT_SEARCH=auto
DREAMGRID_SERPAPI_API_KEY=
