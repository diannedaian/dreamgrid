# Copy this file to .env for local development. Never commit .env.
DREAMGRID_ENVIRONMENT=development
DREAMGRID_LOG_LEVEL=INFO
DREAMGRID_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Server only. Never use a VITE_ prefix for an API key.
OPENAI_API_KEY=
DREAMGRID_OPENAI_MODEL=gpt-5.6-sol
DREAMGRID_OPENAI_REASONING_EFFORT=high
# Matches the successful Sol lamp/plant tests; output cap includes reasoning tokens.
DREAMGRID_OPENAI_MAX_OUTPUT_TOKENS=12000
DREAMGRID_OPENAI_REQUEST_TIMEOUT_SECONDS=600
# Maximum live analysis attempts per backend process, not a billing guarantee.
DREAMGRID_OPENAI_MAX_CALLS=30
DREAMGRID_BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
# Exact allowed hosts; single HTTPS page only, no redirects or arbitrary browsing.
DREAMGRID_PRODUCT_HOSTS=["mitylite.com","www.ikea.com","www.target.com"]
DREAMGRID_PRODUCT_SOURCING=auto
DREAMGRID_PRODUCT_SEARCH=auto
DREAMGRID_COMMERCE_OPENAI_MODEL=gpt-4.1-mini
SERPAPI_API_KEY=
# Sandbox agent payments (no card network). Signs mock payment-intent tokens; set a long random value.
DREAMGRID_PAYMENT_SIGNING_KEY=change-me-to-a-long-random-string
# WebAuthn relying party for passkey approvals; origins on this host (any port) are accepted.
DREAMGRID_PASSKEY_RP_ID=localhost
# Optional: Visa Acceptance (Cybersource) SANDBOX merchant. When all three are set, authorizations
# go to apitest.visaacceptance.com with Visa's test card; otherwise the local sandbox answers.
# DREAMGRID_PAYMENT_NETWORK=auto|sandbox|visa-acceptance
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_KEY_ID=
VISA_ACCEPTANCE_SHARED_SECRET=
